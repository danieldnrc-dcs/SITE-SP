{
  "$description": "Design System 'Painel CPI' — tokens no formato W3C Design Tokens (DTCG). Fonte: index.html. Tema único: escuro.",
  "color": {
    "surface": {
      "bg":      { "$type": "color", "$value": "#080b09", "$description": "Fundo da página" },
      "panel":   { "$type": "color", "$value": "#0d1310", "$description": "Cards, tiles de KPI, hero" },
      "panel-2": { "$type": "color", "$value": "#0a0f0c", "$description": "Áreas rebaixadas (trilho de barra)" }
    },
    "line": {
      "default":   { "$type": "color", "$value": "rgba(120,200,150,0.14)", "$description": "Bordas, divisórias, grade" },
      "strong":    { "$type": "color", "$value": "rgba(120,200,150,0.22)", "$description": "thead, linha de total, eixo zero" },
      "row-hover": { "$type": "color", "$value": "rgba(120,200,150,0.04)", "$description": "Hover de linha de tabela" }
    },
    "accent": {
      "green":     { "$type": "color", "$value": "#37d97f", "$description": "Primário: positivo, capacidade, eyebrows, links, série principal" },
      "green-dim": { "$type": "color", "$value": "#1f6b45", "$description": "Borda de pill e chip verde" },
      "blue":      { "$type": "color", "$value": "#4cb5f5", "$description": "Série de dados secundária" },
      "amber":     { "$type": "color", "$value": "#f2c14e", "$description": "Atenção, ressalva, correção" },
      "red":       { "$type": "color", "$value": "#f2584b", "$description": "A dívida, alarme, número-chave" },
      "red-dim":   { "$type": "color", "$value": "#5a1f1c", "$description": "Borda de pill vermelha (reservado)" },
      "red-glow":  { "$type": "color", "$value": "rgba(242,88,75,0.10)", "$description": "Brilho radial do hero" }
    },
    "text": {
      "ink":   { "$type": "color", "$value": "#e9f2ec", "$description": "Texto principal — 16,4:1 sobre panel" },
      "ink-2": { "$type": "color", "$value": "#93a49b", "$description": "Texto secundário — 7,2:1 sobre panel" },
      "muted": { "$type": "color", "$value": "#5d6b63", "$description": "Rótulos de apoio — 3,4:1 sobre panel (não usar para informação essencial)" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"] }
    },
    "size": {
      "micro":   { "$type": "dimension", "$value": "0.66rem", "$description": "Rótulo de KPI" },
      "label":   { "$type": "dimension", "$value": "0.68rem", "$description": "thead, tag do hero" },
      "eyebrow": { "$type": "dimension", "$value": "0.72rem", "$description": "Eyebrow, número de seção, chip de fonte" },
      "caption": { "$type": "dimension", "$value": "0.78rem" },
      "small":   { "$type": "dimension", "$value": "0.85rem", "$description": "Tabelas" },
      "body":    { "$type": "dimension", "$value": "0.92rem" },
      "lead":    { "$type": "dimension", "$value": "0.98rem" },
      "h3":      { "$type": "dimension", "$value": "1.25rem" },
      "kpi":     { "$type": "dimension", "$value": "1.5rem" },
      "h1":      { "$type": "dimension", "$value": "clamp(1.4rem,3.6vw,2.1rem)" },
      "hero":    { "$type": "dimension", "$value": "clamp(2.4rem,8vw,3.6rem)" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "letter-spacing": {
      "eyebrow": { "$type": "dimension", "$value": "0.14em" },
      "label":   { "$type": "dimension", "$value": "0.1em" },
      "tight":   { "$type": "dimension", "$value": "-0.02em" }
    },
    "line-height": {
      "body":    { "$type": "number", "$value": 1.5 },
      "heading": { "$type": "number", "$value": 1.15 },
      "numeric": { "$type": "number", "$value": 1.05 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "6px" },
    "2": { "$type": "dimension", "$value": "10px" },
    "3": { "$type": "dimension", "$value": "14px", "$description": "Gap entre cards e colunas" },
    "4": { "$type": "dimension", "$value": "20px", "$description": "Padding de card" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "34px", "$description": "Margem entre seções" },
    "7": { "$type": "dimension", "$value": "44px" }
  },
  "radius": {
    "xs":      { "$type": "dimension", "$value": "3px" },
    "sm":      { "$type": "dimension", "$value": "4px" },
    "pill-sq": { "$type": "dimension", "$value": "5px" },
    "md":      { "$type": "dimension", "$value": "14px" },
    "lg":      { "$type": "dimension", "$value": "16px" },
    "full":    { "$type": "dimension", "$value": "999px" }
  },
  "layout": {
    "wrap-max":  { "$type": "dimension", "$value": "1000px" },
    "bp-mobile": { "$type": "dimension", "$value": "720px" }
  },
  "chart": {
    "series": {
      "$description": "Ordem de atribuição de cor às séries. Vermelho é reservado para a dívida/linha de referência.",
      "1": { "$type": "color", "$value": "{color.accent.green}" },
      "2": { "$type": "color", "$value": "{color.accent.blue}" },
      "3": { "$type": "color", "$value": "{color.accent.amber}" },
      "4": { "$type": "color", "$value": "{color.text.ink-2}" },
      "5": { "$type": "color", "$value": "{color.text.muted}" },
      "debt": { "$type": "color", "$value": "{color.accent.red}" }
    }
  }
}
